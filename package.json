{
  "name": "threads-of-the-journey",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:boundaries && npm run test:observer && npm run test:mediator && npm run test:chain",
    "test:boundaries": "tsx src/tests/scenario-boundaries.test.mjs",
    "test:observer": "tsx src/scenarios/observer/model.test.ts",
    "test:mediator": "tsx src/scenarios/mediator/model.test.ts",
    "test:chain": "tsx src/scenarios/chain/model.test.ts"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.21.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@xyflow/react": "12.12.1"
  }
}
